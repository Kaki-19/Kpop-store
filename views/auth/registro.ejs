<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registro - KPop Store </title>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Nunito', sans-serif;
      background: linear-gradient(135deg, #ffeef8 0%, #f0e6ff 50%, #e6f3ff 100%);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .card {
      background: white;
      padding: 2.5rem;
      border-radius: 24px;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 8px 32px rgba(255,182,217,0.3);
      border: 2px solid #ffe4f3;
    }
    .logo { text-align: center; margin-bottom: 1.5rem; }
    .logo h1 {
      font-size: 1.8rem;
      font-weight: 800;
      background: linear-gradient(135deg, #ff9de2, #b39ddb);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .logo p { color: #bbb; font-size: 0.9rem; margin-top: 4px; }
    .form-group { margin-bottom: 1.2rem; }
    label { display: block; margin-bottom: 6px; font-weight: 700; color: #888; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; }
    input {
      width: 100%;
      padding: 12px 16px;
      border: 2px solid #f0e6ff;
      border-radius: 12px;
      font-family: 'Nunito', sans-serif;
      font-size: 1rem;
      color: #555;
      transition: border 0.2s;
      outline: none;
    }
    input:focus { border-color: #ff9de2; }
    .btn {
      width: 100%;
      padding: 13px;
      background: linear-gradient(135deg, #ff9de2, #b39ddb);
      color: white;
      border: none;
      border-radius: 12px;
      font-family: 'Nunito', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 0.5rem;
      transition: opacity 0.2s;
    }
    .btn:hover { opacity: 0.9; }
    .error {
      background: #fff0f5;
      color: #ff6b9d;
      padding: 10px 14px;
      border-radius: 10px;
      margin-bottom: 1rem;
      font-size: 0.9rem;
      border: 1px solid #ffd6e7;
    }
    .footer-text { text-align: center; margin-top: 1.2rem; color: #aaa; font-size: 0.9rem; }
    .footer-text a { color: #ff9de2; font-weight: 700; text-decoration: none; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">
      <h1>🌸 Crear cuenta</h1>
      <p>Únete a KPop Store</p>
    </div>
    <% if (error) { %>
      <div class="error"> <%= error %></div>
    <% } %>
    <form method="POST" action="/auth/registro">
      <div class="form-group">
        <label>Nombre</label>
        <input type="text" name="nombre" placeholder="Tu nombre" required>
      </div>
      <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" placeholder="tu@email.com" required>
      </div>
      <div class="form-group">
        <label>Contraseña</label>
        <input type="password" name="password" placeholder="••••••••" required minlength="6">
      </div>
      <button class="btn" type="submit">Crear cuenta </button>
    </form>
    <p class="footer-text">¿Ya tienes cuenta? <a href="/auth/login">Inicia sesión</a></p>
  </div>
</body>
</html>