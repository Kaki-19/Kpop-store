<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar Pedido - KPop Store</title>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Nunito', sans-serif; background: #fdf6ff; min-height: 100vh; }
    
    /* Navbar consistente */
    nav { background: white; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2px 12px rgba(255,182,217,0.2); border-bottom: 2px solid #ffe4f3; }
    .nav-logo { font-size: 1.3rem; font-weight: 800; background: linear-gradient(135deg, #ff9de2, #b39ddb); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .nav-links a { color: #aaa; text-decoration: none; margin-left: 1.5rem; font-weight: 700; font-size: 0.95rem; }
    .nav-links a.active { color: #ff9de2; }

    .container { display: flex; align-items: center; justify-content: center; min-height: 80vh; padding: 2rem 1.5rem; }
    
    .checkout-card {
      background: white; border-radius: 24px; padding: 2.5rem 2rem;
      box-shadow: 0 4px 16px rgba(255,182,217,0.15); border: 2px solid #ffeef8;
      max-width: 500px; width: 100%; text-align: center;
    }
    
    h1 { font-size: 1.6rem; font-weight: 800; color: #555; margin-bottom: 1.5rem; }
    .emoji-title { font-size: 2.5rem; margin-bottom: 0.5rem; }

    .form-group { margin-bottom: 1.2rem; text-align: left; }
    .form-group label { display: block; font-weight: 700; color: #777; margin-bottom: 0.4rem; font-size: 0.9rem; }
    
    .form-control {
      width: 100%; padding: 12px 16px; border: 2px solid #ffeef8; border-radius: 12px;
      font-family: 'Nunito', sans-serif; font-size: 0.95rem; color: #555; background: #fffcfd;
    }
    .form-control:focus { outline: none; border-color: #ff9de2; }

    .btn {
      width: 100%; padding: 14px; border: none; border-radius: 12px; font-family: 'Nunito', sans-serif; 
      font-weight: 700; cursor: pointer; font-size: 1rem; transition: opacity 0.2s; margin-top: 0.5rem;
    }
    .btn-primary { background: linear-gradient(135deg, #ff9de2, #b39ddb); color: white; }
    .btn-secondary { background: #666; color: white; }
    .btn:hover { opacity: 0.9; }
  </style>
</head>
<body>

  <nav>
    <span class="nav-logo">KPop Store</span>
    <div class="nav-links">
      <a href="/pedidos/dashboard">Dashboard</a>
      <a href="/productos">Productos</a>
      <a href="/pedidos" class="active">Pedidos</a>
      <a href="/auth/logout">Salir</a>
    </div>
  </nav>

  <div class="container">
    <div class="checkout-card">
      <div class="emoji-title">🌸</div>
      <h1>Editar Pedido</h1>
      
      <form method="POST" action="/pedidos/editar/<%= pedido._id %>">
        <div class="form-group">
          <label>Estado del pedido</label>
          <select name="estado" class="form-control">
            <option value="pendiente" <%= pedido.estado === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
            <option value="enviado" <%= pedido.estado === 'enviado' ? 'selected' : '' %>>Enviado</option>
            <option value="entregado" <%= pedido.estado === 'entregado' ? 'selected' : '' %>>Entregado</option>
            <option value="cancelado" <%= pedido.estado === 'cancelado' ? 'selected' : '' %>>Cancelado</option>
          </select>
        </div>

        <div class="form-group">
          <label>Dirección de envío</label>
          <input type="text" name="direccion" value="<%= pedido.direccion %>" class="form-control" required>
        </div>

        <button class="btn btn-primary" type="submit">Guardar cambios </button>
        <a href="/pedidos" class="btn btn-secondary" style="display:block; text-decoration:none; margin-top:10px; background:#f0f0f0; color:#777;">Cancelar</a>
      </form>
    </div>
  </div>

</body>
</html>