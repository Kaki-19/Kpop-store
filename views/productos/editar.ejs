<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar Producto - KPop Store </title>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Nunito', sans-serif; background: #fdf6ff; min-height: 100vh; }
    nav {
      background: white;
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 2px 12px rgba(255,182,217,0.2);
      border-bottom: 2px solid #ffe4f3;
    }
    .nav-logo {
      font-size: 1.3rem;
      font-weight: 800;
      background: linear-gradient(135deg, #ff9de2, #b39ddb);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .nav-links a { color: #aaa; text-decoration: none; margin-left: 1.5rem; font-weight: 700; }
    .nav-links a:hover { color: #ff9de2; }
    .container { max-width: 600px; margin: 2rem auto; padding: 0 1.5rem; }
    h1 { font-size: 1.8rem; font-weight: 800; color: #555; margin-bottom: 1.5rem; }
    .card {
      background: white;
      border-radius: 24px;
      padding: 2rem;
      box-shadow: 0 4px 16px rgba(255,182,217,0.15);
      border: 2px solid #ffeef8;
    }
    .form-group { margin-bottom: 1.2rem; }
    label { display: block; margin-bottom: 6px; font-weight: 700; color: #888; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; }
    input, select, textarea {
      width: 100%;
      padding: 12px 16px;
      border: 2px solid #f0e6ff;
      border-radius: 12px;
      font-family: 'Nunito', sans-serif;
      font-size: 1rem;
      color: #555;
      outline: none;
      transition: border 0.2s;
    }
    input:focus, select:focus, textarea:focus { border-color: #ff9de2; }
    .btn {
      padding: 12px 24px;
      border: none;
      border-radius: 12px;
      font-family: 'Nunito', sans-serif;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      font-size: 0.95rem;
      transition: opacity 0.2s;
    }
    .btn:hover { opacity: 0.85; }
    .btn-primary { background: linear-gradient(135deg, #ff9de2, #b39ddb); color: white; }
    .btn-secondary { background: #f0e6ff; color: #9b7fd4; }
    .actions { display: flex; gap: 10px; margin-top: 0.5rem; }
    .preview-img {
      width: 100%;
      height: 160px;
      object-fit: cover;
      border-radius: 12px;
      margin-top: 8px;
      border: 2px solid #f0e6ff;
    }
  </style>
</head>
<body>
  <nav>
    <span class="nav-logo"> KPop Store</span>
    <div class="nav-links">
      <a href="/pedidos/dashboard">Dashboard</a>
      <a href="/productos">Productos</a>
      <a href="/pedidos">Pedidos</a>
      <a href="/auth/logout">Salir</a>
    </div>
  </nav>
  <div class="container">
    <h1> Editar Producto</h1>
    <div class="card">
      <form method="POST" action="/productos/editar/<%= producto._id %>" enctype="multipart/form-data">
        <div class="form-group">
          <label>Nombre</label>
          <input type="text" name="nombre" value="<%= producto.nombre %>" required>
        </div>
        <div class="form-group">
          <label>Artista</label>
          <input type="text" name="artista" value="<%= producto.artista %>" required>
        </div>
        <div class="form-group">
          <label>Categoría</label>
          <select name="categoria" required>
            <option value="album" <%= producto.categoria === 'album' ? 'selected' : '' %>> Álbum</option>
            <option value="photocard" <%= producto.categoria === 'photocard' ? 'selected' : '' %>> Photocard</option>
            <option value="lightstick" <%= producto.categoria === 'lightstick' ? 'selected' : '' %>> Lightstick</option>
            <option value="ropa" <%= producto.categoria === 'ropa' ? 'selected' : '' %>> Ropa</option>
            <option value="otro" <%= producto.categoria === 'otro' ? 'selected' : '' %>> Otro</option>
          </select>
        </div>
        <div class="form-group">
          <label>Precio</label>
          <input type="number" name="precio" value="<%= producto.precio %>" min="0" required>
        </div>
        <div class="form-group">
          <label>Stock</label>
          <input type="number" name="stock" value="<%= producto.stock %>" min="0" required>
        </div>
        <div class="form-group">
          <label>Descripción</label>
          <textarea name="descripcion" rows="3"><%= producto.descripcion %></textarea>
        </div>
        <div class="form-group">
          <label>Foto del Producto</label>
          <input type="file" name="imagen" id="imagenInput" accept="image/*">
          
          <% if (producto.imagenUrl || producto.imagen) { %>
            <img id="previewImg" class="preview-img" src="<%= producto.imagenUrl || producto.imagen %>" alt="Preview">
          <% } else { %>
            <img id="previewImg" class="preview-img" alt="Preview" style="display:none">
          <% } %>
        </div>
        <div class="actions">
          <button class="btn btn-primary" type="submit"> Guardar cambios</button>
          <a href="/productos" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
  
  <script>
    const input = document.getElementById('imagenInput');
    const preview = document.getElementById('previewImg');
    
    input.addEventListener('change', () => {
      const archivos = input.files;
      if (archivos && archivos.length > 0) {
        const primerArchivo = archivos[0];
        const objectURL = URL.createObjectURL(primerArchivo);
        preview.src = objectURL;
        preview.style.display = 'block';
      }
    });
  </script>
</body>
</html>