<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Productos - KPop Store</title>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Nunito', sans-serif; background: #fdf6ff; min-height: 100vh; }
    nav {
      background: white;
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 2px 12px rgba(255,182,217,0.2);
      border-bottom: 2px solid #ffe4f3;
    }
    .nav-logo {
      font-size: 1.3rem;
      font-weight: 800;
      background: linear-gradient(135deg, #ff9de2, #b39ddb);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .nav-links a {
      color: #aaa;
      text-decoration: none;
      margin-left: 1.5rem;
      font-weight: 700;
      font-size: 0.95rem;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: #ff9de2; }
    .container { max-width: 1100px; margin: 2rem auto; padding: 0 1.5rem; }
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }
    h1 { font-size: 1.8rem; font-weight: 800; color: #555; }
    .btn {
      padding: 10px 20px;
      border: none;
      border-radius: 12px;
      font-family: 'Nunito', sans-serif;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: opacity 0.2s;
      font-size: 0.95rem;
    }
    .btn:hover { opacity: 0.85; }
    .btn-primary { background: linear-gradient(135deg, #ff9de2, #b39ddb); color: white; }
    .btn-danger { background: #ffe4f0; color: #ff6b9d; }
    .btn-secondary { background: #f0e6ff; color: #9b7fd4; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 1.2rem;
    }
    .card {
      background: white;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(255,182,217,0.15);
      border: 2px solid #ffeef8;
      transition: transform 0.2s;
    }
    .card:hover { transform: translateY(-4px); }
    .card-img {
      width: 100%;
      height: 160px;
      object-fit: cover;
    }
    .card-img-placeholder {
      width: 100%;
      height: 160px;
      background: linear-gradient(135deg, #ffeef8, #f0e6ff);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
    }
    .card-body { padding: 1.2rem; }
    .card-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 700;
      margin-bottom: 0.8rem;
      text-transform: uppercase;
    }
    .badge-album { background: #ffeef8; color: #ff9de2; }
    .badge-photocard { background: #f0e6ff; color: #b39ddb; }
    .badge-lightstick { background: #e6f3ff; color: #7eb8f7; }
    .badge-ropa { background: #e6fff3; color: #5ec98a; }
    .badge-otro { background: #fff8e6; color: #f7c05e; }
    .card h3 { font-size: 1rem; font-weight: 800; color: #555; margin-bottom: 4px; }
    .card .artista { color: #aaa; font-size: 0.85rem; margin-bottom: 0.8rem; }
    .card .precio { font-size: 1.3rem; font-weight: 800; color: #ff9de2; margin-bottom: 4px; }
    .card .stock { font-size: 0.8rem; color: #bbb; margin-bottom: 1rem; }
    .card-actions { display: flex; gap: 8px; }
    .empty { text-align: center; padding: 3rem; color: #bbb; }
    .empty p { font-size: 1.1rem; margin-top: 0.5rem; }
    
    .cart-badge {
      background: #ff9de2;
      color: white;
      font-size: 0.75rem;
      padding: 2px 6px;
      border-radius: 50%;
      font-weight: 800;
      vertical-align: middle;
      margin-left: 2px;
    }
  </style>
</head>
<body>
  <nav>
    <span class="nav-logo">KPop Store</span>
    <div class="nav-links">
      <% if (typeof session !== 'undefined' && session.usuarioRol === 'admin') { %>
        <a href="/pedidos/dashboard">Dashboard</a>
        <a href="/productos">Productos</a>
        <a href="/pedidos">Pedidos</a>
      <% } else { %>
        <a href="/productos">Tienda</a>
        <a href="/carrito">🛒 Carrito 
          <span class="cart-badge" id="cart-count">
            <%= (typeof session !== 'undefined' && session.carrito) ? session.carrito.reduce((acc, item) => acc + item.cantidad, 0) : 0 %>
          </span>
        </a>
      <% } %>
      <a href="/auth/logout">Salir (<%= (typeof session !== 'undefined') ? session.usuarioNombre : 'Usuario' %>)</a>
    </div>
  </nav>

  <div class="container">
    <div class="page-header">
      <h1><%= (typeof session !== 'undefined' && session.usuarioRol === 'admin') ? 'Panel de Productos' : 'Catálogo K-Pop' %></h1>
      
      <% if (typeof session !== 'undefined' && session.usuarioRol === 'admin') { %>
        <a href="/productos/nuevo" class="btn btn-primary">+ Nuevo producto</a>
      <% } %>
    </div>

    <% if (productos.length === 0) { %>
      <div class="empty">
        <div style="font-size:3rem">🎵</div>
        <p>No hay productos aún.</p>
      </div>
    <% } else { %>
    <div class="grid">
      <% productos.forEach(p => { %>
      <div class="card">
        <% if (p.imagenUrl) { %>
          <img class="card-img" src="<%= p.imagenUrl %>" alt="<%= p.nombre %>" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
          <div class="card-img-placeholder" style="display:none">🎵</div>
        <% } else { %>
          <div class="card-img-placeholder">🎵</div>
        <% } %>
        <div class="card-body">
          <span class="card-badge badge-<%= p.categoria %>"><%= p.categoria %></span>
          <h3><%= p.nombre %></h3>
          <p class="artista"> <%= p.artista %></p>
          <p class="precio">$<%= p.precio %></p>
          <p class="stock">Stock: <%= p.stock %> disponibles</p>
          
          <div class="card-actions">
            <% if (typeof session !== 'undefined' && session.usuarioRol === 'admin') { %>
              <a href="/productos/editar/<%= p._id %>" class="btn btn-secondary" style="flex: 1; text-align: center;">Editar</a>
              <form method="POST" action="/productos/eliminar/<%= p._id %>" style="display:inline; flex: 1;" onsubmit="return confirm('¿Eliminar?')">
                <button class="btn btn-danger" type="submit" style="width: 100%;">Eliminar</button>
              </form>
            <% } else { %>
              <button onclick="agregarAlCarrito('<%= p._id %>')" class="btn btn-secondary" style="flex: 1; padding: 10px 10px; font-size: 0.85rem;">
                 Al Carrito
              </button>
              <a href="/productos/comprar/<%= p._id %>" class="btn btn-primary" style="flex: 1; text-align: center; padding: 10px 10px; font-size: 0.85rem;"> Comprar</a>
            <% } %>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>

  <div id="notification-toast" style="
    position: fixed; top: 25px; right: -360px; background: white; 
    padding: 1.1rem 1.6rem; border-radius: 16px; font-weight: 700; color: #555;
    box-shadow: 0 4px 20px rgba(255,157,226,0.25); border: 2px solid #ffe4f3;
    display: flex; align-items: center; gap: 12px; z-index: 9999;
    transition: right 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    font-size: 0.95rem;
  ">
    <span style="font-size: 1.4rem;">🌸</span>
    <span>¡Agregado al carrito con éxito!</span>
  </div>

  <script>
    function agregarAlCarrito(productoId) {
      fetch(`/carrito/agregar/${productoId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          // Actualiza el contador dinámico en tiempo real
          const countBadge = document.getElementById('cart-count');
          if (countBadge) countBadge.innerText = data.cantidadTotal;

          // Dispara la animación del Toast hacia adentro
          const toast = document.getElementById('notification-toast');
          toast.style.right = '25px';

          // Lo regresa a su posición oculta tras 3 segundos
          setTimeout(() => {
            toast.style.right = '-360px';
          }, 3000);
        } else {
          alert('No se pudo añadir el producto en este momento.');
        }
      })
      .catch(err => {
        console.error('Error en la petición del carrito:', err);
      });
    }
  </script>
</body>
</html>